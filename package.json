{
  "name": "babeltag",
  "version": "1.0.0",
  "description": "Tag a self-hosted music library by artist country and song language, so Navidrome smart playlists can split it into shows.",
  "keywords": [
    "navidrome",
    "musicbrainz",
    "music",
    "tagging",
    "metadata",
    "selfhosted",
    "subsonic",
    "language",
    "id3"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "babeltag": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter=spec test/*.test.ts",
    "test:smoke": "node --experimental-strip-types --test --test-reporter=spec test/smoke.test.ts",
    "start": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "node-taglib-sharp": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
